# KodeArrow Environment Configuration Template
# Duplicate this file to .env and fill in your credentials.

# --- Firebase Configuration ---
# Get these from your Firebase Console -> Project Settings -> Service Accounts
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=<YOUR_PROJECT_ID>
FIREBASE_PRIVATE_KEY_ID=<YOUR_PRIVATE_KEY_ID>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<YOUR_PRIVATE_KEY_CONTENT>\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=<YOUR_CLIENT_EMAIL>
FIREBASE_CLIENT_ID=<YOUR_CLIENT_ID>

# --- Application Settings ---
APP_NAME=KodeArrow
APP_VERSION=2.5.0-dev
DEBUG=False
LOG_LEVEL=INFO

# --- License Settings ---
# Standard Edition License Key
LICENSE_KEY_STANDARD=BTED-SAMPLE-KEY-2023
